{
  "name": "sf-reels",
  "version": "1.0.0",
  "main": "electron.js",
  "description": "Remotion-based Instagram Reels generator for SF development projects",
  "scripts": {
    "preview": "remotion preview",
    "build": "remotion render src/index.ts SFProjectReel",
    "generate-voiceover": "ts-node scripts/generate-voiceover.ts",
    "render-reel": "ts-node scripts/render-reel.ts",
    "dashboard": "ts-node src/server/index.ts",
    "dev": "ts-node src/server/index.ts",
    "desktop": "electron .",
    "dist": "electron-builder --dir",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux"
  },
  "build": {
    "appId": "com.sfreels.generator",
    "productName": "SF Reels Generator",
    "files": [
      "electron.js",
      "src/**/*",
      "public/**/*",
      "scripts/**/*",
      "node_modules/**/*",
      "tsconfig.json",
      ".env"
    ],
    "directories": {
      "output": "dist-electron"
    },
    "mac": {
      "category": "public.app-category.video",
      "target": "dmg"
    },
    "win": {
      "target": "portable"
    },
    "linux": {
      "target": "AppImage",
      "category": "Video"
    }
  },
  "dependencies": {
    "@remotion/cli": "4.0.242",
    "@remotion/media-utils": "4.0.242",
    "@remotion/player": "4.0.242",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "mapbox-gl": "^3.9.4",
    "multer": "^1.4.5-lts.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "4.0.242",
    "uuid": "^11.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/mapbox-gl": "^3.4.1",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/uuid": "^10.0.0",
    "dotenv": "^16.4.7",
    "electron": "^41.0.3",
    "electron-builder": "^26.8.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}
